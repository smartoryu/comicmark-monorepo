# ComicMark API — example environment configuration.
#
# Copy to `.env` and adjust. Every variable is optional except JWT_SECRET:
# real environment variables always win over this file, and a variable left
# blank is treated as unset (its default applies).
#
# Generate a secret with:  openssl rand -hex 32

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | production | test
APP_ENV=development

# Where verification and password-reset links point. In `flutter run` dev mode
# this is the Flutter web dev server; for the embedded build it must be the
# API's own origin (http://localhost:8080) so links resolve to the served app.
APP_BASE_URL=http://localhost:5173

SERVER_ADDR=:8080
DATABASE_PATH=./data/comicmark.db

# Required. Must be at least 32 bytes unless APP_ENV=development.
JWT_SECRET=
JWT_ISSUER=comicmark

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SESSION_IDLE_TTL=720h
SESSION_TOUCH_INTERVAL=5m

# Comma-separated allowlist. "*" is rejected because credentials are sent.
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
AUTH_RATE_LIMIT_PER_MIN=5
SENSITIVE_RATE_LIMIT_PER_MIN=3

# When true, an unverified account cannot log in (403 email_not_verified).
AUTH_REQUIRE_EMAIL_VERIFICATION=false
VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=1h

# ---------------------------------------------------------------------------
# Mailer
# ---------------------------------------------------------------------------
# console | smtp
#   console -> prints the message and its link to the log (no SMTP needed)
#   smtp    -> talks to SMTP_HOST/SMTP_PORT (the compose Mailpit stack)
MAILER_DRIVER=console
MAILER_FROM=ComicMark <no-reply@comicmark.local>

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT=10s

# ---------------------------------------------------------------------------
# Scraper
# ---------------------------------------------------------------------------
SCRAPER_USER_AGENT=ComicMarkBot/1.0
SCRAPER_CONTACT_URL=https://example.com/bot
SCRAPER_TIMEOUT=10s
SCRAPER_MAX_BYTES=2097152

# DANGER: disables the SSRF guard so local fixtures can be scraped. Used by
# scripts/e2e.sh. Rejected in production.
SCRAPER_ALLOW_PRIVATE_IPS=false

# ---------------------------------------------------------------------------
# Firebase (optional social sign-in)
# ---------------------------------------------------------------------------
# Leave FIREBASE_PROJECT_ID blank to disable Google sign-in entirely: the
# /auth/firebase route is not mounted and the app hides the Google button.
FIREBASE_PROJECT_ID=
# Path to a service-account JSON. Leave blank to use Application Default
# Credentials (GOOGLE_APPLICATION_CREDENTIALS).
FIREBASE_CREDENTIALS_FILE=
# Firebase Auth emulator host, e.g. localhost:9099. Never set in production.
FIREBASE_AUTH_EMULATOR_HOST=
